if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj762 0 obj<</JS(function ShowCompProps_B9A3A538F54D45D3AF1E419731149E8F\(\){var sChoice = app.popUpMenu\("Comment: SW-PUSH-CMS","Component Kind: Standard","ComponentLink1Description: Datasheet","ComponentLink1URL: http://tunmcdsvn.tun.st.com/Component_Datasheet_Library/T\runk/Misc/Wealthmetal_Tact-Switch_TD0341","Database Table Name: MCD_PARTS$","Description: Non-Open Push-Button 0.1A 24V","ECCN_EU: n/a","ECCN_US: n/a","Footprint: SWI_WEALTHMETAL_TD-0341_4P_BLUE","Ibis Model: ","Internal_Part_Number: MCD-00002","Library N\ame: MCD_PARTS_database.DbLib","Library Reference: MCD-00002","Manufacturer: WEALTHMETAL","Manufacturer_Part_Number: TD-0341","Part_Type: Misc","PCB3D: ","Provided_By: SUBCO","Revision: ","Signal Integrity: ","Simulation: ","Status: Released","Value: SWIT\CH"\); if \(sChoice\) {var nUrlPos = sChoice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPo\s !== -1\) app.openDoc\(sChoice.substr\(nPathPos+2\)\);};};})/S/J