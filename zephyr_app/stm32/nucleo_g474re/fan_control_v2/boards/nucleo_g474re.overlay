/*
 * Fan control node overlay.
 *
 * Arduino header pin usage on this project:
 *   D10 (PB6)  - TIM4_CH1 PWM  -> fan PWM input   (25 kHz)
 *   D9  (PC7)  - GPIO EXTI     -> fan tach output (open-collector, internal pull-up)
 *   A0  (PA0)  - ADC1_IN1      -> voltage sensor module "S" pin
 *   A1  (PA1)  - ADC1_IN2      -> ACS712 current sensor "OUT" pin
 *
 * D10 also carries the default arduino_spi (spi1) chip-select. spi1 is not
 * used by this project, so it is disabled to free PB6 for the fan PWM.
 */

/ {
	zephyr,user {
		io-channels = <&adc1 1>, <&adc1 2>;
		pwms = <&pwm4 1 PWM_USEC(40) PWM_POLARITY_NORMAL>;
		fan-tach-gpios = <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

&spi1 {
	status = "disabled";
};

&timers4 {
	status = "okay";

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6>;
		pinctrl-names = "default";
	};
};

&tim4_ch1_pb6 {
	bias-pull-up;
	drive-open-drain;
};

&fdcan1 {
	bitrate = <500000>;
};

&adc1 {
	pinctrl-0 = <&adc1_in1_pa0 &adc1_in2_pa1>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
